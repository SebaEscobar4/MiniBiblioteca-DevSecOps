# ============================================================
# PLANTILLA DE NGINX (se procesa al arrancar el contenedor)
# ============================================================
# La imagen oficial reemplaza ${VARIABLE} con variables de entorno y deja
# el resultado en /etc/nginx/conf.d/default.conf. Así la misma imagen
# funciona en Docker Compose y en Kubernetes:
#
#   Variable        Docker Compose     Kubernetes
#   NGINX_RESOLVER  127.0.0.11         kube-dns.kube-system.svc.cluster.local
#   BACKEND_HOST    backend            backend.minibiblioteca.svc.cluster.local
#
# Las variables propias de Nginx ($host, $uri...) no se tocan porque no
# existen como variables de entorno.
# ============================================================

# DNS interno: Nginx vuelve a consultar cada 10 s cuántas réplicas de
# "backend" existen, así detecta las que se agregan o quitan sin reiniciar.
resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

# Grupo de réplicas del backend. Nginx reparte las peticiones entre ellas
# (round-robin) y deja de enviar tráfico a la que falle.
upstream backend_pool {
    zone backend_pool 64k;
    server ${BACKEND_HOST}:8080 resolve max_fails=2 fail_timeout=10s;
    keepalive 16;
}

# Formato de log en JSON: Loki (o CloudWatch) puede filtrar por status,
# ruta o tiempo de respuesta sin parsear texto libre.
log_format json_combined escape=json
  '{"time":"$time_iso8601","remote_addr":"$remote_addr","method":"$request_method",'
  '"uri":"$request_uri","status":$status,"bytes":$body_bytes_sent,'
  '"request_time":$request_time,"upstream":"$upstream_addr","user_agent":"$http_user_agent"}';

server {
    listen 8080;
    server_name _;

    access_log /dev/stdout json_combined;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Disponibilidad del propio frontend (Docker, Kubernetes y Prometheus).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # El navegador llama /api y Nginx lo reenvía al grupo de réplicas.
    location /api/ {
        proxy_pass http://backend_pool/api/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Red interna: si una réplica no conecta en 2 s, está caída.
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;

        # Si una réplica no responde, la petición se reintenta en otra:
        # el usuario no ve el error.
        proxy_next_upstream error timeout http_502 http_503;
        proxy_next_upstream_tries 2;

        # Muestra qué réplica atendió (útil para comprobar el balanceo).
        add_header X-Backend-Replica $upstream_addr always;
    }
}
